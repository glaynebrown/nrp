rules_version = '2';

// Each person can only ever read or write their own users/{uid} tree.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['title', 'text', 'cardId', 'strokes', 'h', 'updated'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.text is string && request.resource.data.text.size() <= 100000;
      }
    }
  }
}
